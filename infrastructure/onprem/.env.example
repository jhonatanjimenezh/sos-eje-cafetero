# Copiar a .env y reemplazar TODOS los valores change-me antes de usar datos reales.
SITE_ADDRESS=http://localhost
HTTP_PORT=80
HTTPS_PORT=443
WEB_ORIGIN=http://localhost

POSTGRES_DB=sos
POSTGRES_USER=sos
POSTGRES_PASSWORD=change-me-long-random-password

# Versiones reproducibles. La organización puede sustituirlas por imágenes/digests aprobados internamente.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-06T17-38-46Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-07-21T05-28-08Z
CLAMAV_IMAGE=clamav/clamav:1.5.3-debian13-slim
MINIO_ROOT_USER=sos-storage-admin
MINIO_ROOT_PASSWORD=change-me-long-random-storage-admin-password
PRIVATE_EVIDENCE_BUCKET=sos-private-evidence
EVIDENCE_RETENTION_DAYS=90

# Cuentas de servicio separadas: el API no recibe credenciales root de MinIO.
S3_API_ACCESS_KEY=sos-api
S3_API_SECRET_KEY=change-me-long-random-api-storage-secret
S3_SCANNER_ACCESS_KEY=sos-evidence-scanner
S3_SCANNER_SECRET_KEY=change-me-long-random-scanner-storage-secret
IDENTITY_HASH_SECRET=change-me-at-least-32-random-bytes

# Scanner local: ClamAV escribe GuardDutyMalwareScanStatus como contrato S3 común con el API.
REQUIRE_MALWARE_SCAN=true
EVIDENCE_SCAN_POLL_SECONDS=2

# SecureEnvelope on-prem. Las claves RSA-3072 privadas se generan una sola vez en el volumen sync_keys.
# Respaldar/custodiar ese volumen: perder la clave de decrypt hace irrecuperables envelopes aún pendientes.
SYNC_ENCRYPTION_KEY_PUBLIC_ID=sync-encryption-v1
SYNC_RECEIPT_SIGNING_KEY_PUBLIC_ID=sync-receipt-v1
SYNC_MAX_ENVELOPE_TTL_SECONDS=259200
SYNC_MAX_CIPHERTEXT_BYTES=12288
SYNC_MAX_BATCH_SIZE=4
# Límite suplementario por emitterKeyId; no agrupa ciudadanos por una IP compartida.
SYNC_BATCH_REQUESTS_PER_MINUTE=60

# Reencuentro unilateral. Generar un secreto independiente de al menos 32 bytes y custodiarlo
# fuera de Git. Si está vacío, FEATURE_REUNIFICATION debe permanecer false.
# Ejemplo: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
REUNIFICATION_LOOKUP_KEY_VERSION=1
REUNIFICATION_LOOKUP_SECRET_B64URL=
REUNIFICATION_PREVIOUS_LOOKUP_KEY_VERSION=
REUNIFICATION_PREVIOUS_LOOKUP_SECRET_B64URL=
REUNIFICATION_REQUEST_TTL_DAYS=14

# Solo para laboratorio/on-prem sin proveedor OTP. NO usar como autenticación de producción.
ALLOW_LEGACY_COMMAND_TOKEN=true
COMMAND_CENTER_TOKEN=change-me-long-random-bootstrap-token

# Safe defaults. Las capacidades sensibles se habilitan solo tras superar su gate.
FEATURE_PUBLIC_SOS=true
FEATURE_OPERATIONAL_CENTER=true
FEATURE_AFFECTED_IDENTITY=false
FEATURE_LIVENESS=false
LIVENESS_PROVIDER=MANUAL
LIVENESS_MAX_ATTEMPTS_PER_24H=3
FEATURE_ASSISTANCE_MATCHING=false
FEATURE_WHATSAPP=false
FEATURE_WEBRTC_RELAY=false
FEATURE_OPERATIONAL_LAYERS=false
FEATURE_SECURE_ENVELOPE=false
FEATURE_REUNIFICATION=false
NEXT_PUBLIC_FEATURE_OFFLINE_QUEUE=false
NEXT_PUBLIC_FEATURE_SECURE_ENVELOPE=false
NEXT_PUBLIC_FEATURE_WEBRTC_RELAY=false
NEXT_PUBLIC_FEATURE_LIVENESS=false
NEXT_PUBLIC_LIVENESS_PROVIDER=MANUAL
NEXT_PUBLIC_FEATURE_REUNIFICATION=false

NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
AWS_REGION=us-east-1

# Reencuentro requiere una identidad ciudadana OTP real. En el stack actual on-prem
# Cognito puede seguir siendo el proveedor remoto de OTP; no habilitar reencuentro sin él.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
