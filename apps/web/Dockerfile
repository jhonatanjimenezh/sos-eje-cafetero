FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /workspace
COPY package.json pnpm-workspace.yaml ./
COPY packages/secure-envelope/package.json ./packages/secure-envelope/package.json
COPY apps/web/package.json ./apps/web/package.json
RUN pnpm install --filter @sos/web... --no-frozen-lockfile
COPY packages/secure-envelope ./packages/secure-envelope
COPY apps/web ./apps/web
WORKDIR /workspace/apps/web

ARG NEXT_PUBLIC_API_URL=/api/v1
ARG NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
ARG NEXT_PUBLIC_FEATURE_OFFLINE_QUEUE=false
ARG NEXT_PUBLIC_FEATURE_SECURE_ENVELOPE=false
ARG NEXT_PUBLIC_FEATURE_WEBRTC_RELAY=false
ARG NEXT_PUBLIC_FEATURE_LIVENESS=false
ARG NEXT_PUBLIC_LIVENESS_PROVIDER=MANUAL
ARG NEXT_PUBLIC_FEATURE_REUNIFICATION=false
ARG NEXT_PUBLIC_FEATURE_PET_SAFETY=false
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_MAP_STYLE_URL=${NEXT_PUBLIC_MAP_STYLE_URL}
ENV NEXT_PUBLIC_FEATURE_OFFLINE_QUEUE=${NEXT_PUBLIC_FEATURE_OFFLINE_QUEUE}
ENV NEXT_PUBLIC_FEATURE_SECURE_ENVELOPE=${NEXT_PUBLIC_FEATURE_SECURE_ENVELOPE}
ENV NEXT_PUBLIC_FEATURE_WEBRTC_RELAY=${NEXT_PUBLIC_FEATURE_WEBRTC_RELAY}
ENV NEXT_PUBLIC_FEATURE_LIVENESS=${NEXT_PUBLIC_FEATURE_LIVENESS}
ENV NEXT_PUBLIC_LIVENESS_PROVIDER=${NEXT_PUBLIC_LIVENESS_PROVIDER}
ENV NEXT_PUBLIC_FEATURE_REUNIFICATION=${NEXT_PUBLIC_FEATURE_REUNIFICATION}
ENV NEXT_PUBLIC_FEATURE_PET_SAFETY=${NEXT_PUBLIC_FEATURE_PET_SAFETY}
RUN pnpm build

FROM nginx:1.27-alpine
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/web/out /usr/share/nginx/html
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
