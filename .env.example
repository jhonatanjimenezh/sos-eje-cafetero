NODE_ENV=development
POSTGRES_DB=sos
POSTGRES_USER=sos
POSTGRES_PASSWORD=change-me-now

# Local Compose can use DATABASE_URL. AWS ECS injects DB_PASSWORD from Secrets Manager
# and uses the component variables instead, avoiding a generated URL with secret in Terraform.
DATABASE_URL=postgresql://sos:change-me-now@db:5432/sos
DB_HOST=db
DB_PORT=5432
DB_NAME=sos
DB_USER=sos
DB_PASSWORD=change-me-now
DB_SSL=false

REDIS_URL=redis://redis:6379
PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Feature flags. Defaults conservadores para cualquier entorno que pueda recibir datos reales.
FEATURE_PUBLIC_SOS=true
FEATURE_OPERATIONAL_CENTER=true
FEATURE_AFFECTED_IDENTITY=false
FEATURE_LIVENESS=false
FEATURE_ASSISTANCE_MATCHING=false
FEATURE_WHATSAPP=false
FEATURE_WEBRTC_RELAY=false
FEATURE_OPERATIONAL_LAYERS=false
FEATURE_SECURE_ENVELOPE=false
FEATURE_REUNIFICATION=false
FEATURE_PET_SAFETY=false
NEXT_PUBLIC_FEATURE_LIVENESS=false
NEXT_PUBLIC_LIVENESS_PROVIDER=MANUAL
NEXT_PUBLIC_FEATURE_SECURE_ENVELOPE=false
NEXT_PUBLIC_FEATURE_WEBRTC_RELAY=false
NEXT_PUBLIC_FEATURE_REUNIFICATION=false
NEXT_PUBLIC_FEATURE_PET_SAFETY=false

# Reencuentro unilateral / blind matching anti-stalking.
# Generar con, por ejemplo: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Nunca reutilizar IDENTITY_HASH_SECRET ni almacenar este secreto en Git.
REUNIFICATION_LOOKUP_KEY_VERSION=1
REUNIFICATION_LOOKUP_SECRET_B64URL=
# Mantener la clave anterior durante el TTL máximo al rotar; luego retirarla.
REUNIFICATION_PREVIOUS_LOOKUP_KEY_VERSION=
REUNIFICATION_PREVIOUS_LOOKUP_SECRET_B64URL=
REUNIFICATION_REQUEST_TTL_DAYS=14

# Mascotas seguras. Ambos secretos deben ser independientes, exactamente 32 bytes
# aleatorios codificados base64url, generados fuera del repositorio y nunca en tfstate.
# PET_PROFILE_ENCRYPTION_SECRET cifra el payload privado con AES-256-GCM.
# PET_IDENTITY_HASH_SECRET protege documento/microchip con HMAC-SHA256 domain-separated.
PET_PROFILE_ENCRYPTION_SECRET_B64URL=
PET_IDENTITY_HASH_SECRET_B64URL=
# Si queda vacío, el API reutiliza PRIVATE_EVIDENCE_BUCKET, siempre privado.
PET_MEDIA_BUCKET=
# Producción requiere KMS; puede reutilizar EVIDENCE_KMS_KEY_ID si se deja vacío.
PET_EVIDENCE_KMS_KEY_ID=
PET_EVIDENCE_RETENTION_DAYS=30

# Liveness. REKOGNITION requiere LIVENESS_CLIENT_ROLE_ARN generado por Terraform.
LIVENESS_PROVIDER=MANUAL
LIVENESS_CLIENT_ROLE_ARN=
LIVENESS_MAX_ATTEMPTS_PER_24H=3

# Persistencia offline sensible solo se habilita cuando TAMBIÉN está habilitado SecureEnvelope.
# Si uno de los dos flags es false, el cliente opera online-only y nunca hace fallback a plaintext.
NEXT_PUBLIC_FEATURE_OFFLINE_QUEUE=false

# SecureEnvelope server. LOCAL_PEM sirve para laboratorio/on-prem; AWS Terraform usa AWS_KMS.
# No guardar claves privadas en Git. Los paths siguientes deben apuntar a archivos fuera del repo.
SYNC_KEY_MODE=LOCAL_PEM
SYNC_ENCRYPTION_PRIVATE_KEY_PATH=
SYNC_RECEIPT_SIGNING_PRIVATE_KEY_PATH=
SYNC_ENCRYPTION_KEY_PUBLIC_ID=sync-encryption-v1
SYNC_RECEIPT_SIGNING_KEY_PUBLIC_ID=sync-receipt-v1
SYNC_ENCRYPTION_KMS_KEY_ID=
SYNC_RECEIPT_SIGNING_KMS_KEY_ID=
SYNC_MAX_ENVELOPE_TTL_SECONDS=259200
SYNC_MAX_CIPHERTEXT_BYTES=12288
SYNC_MAX_BATCH_SIZE=4
# Límite suplementario por emitterKeyId, NO por IP compartida/carrier NAT.
SYNC_BATCH_REQUESTS_PER_MINUTE=60
SYNC_CONFIG_CACHE_DAYS=90

# Bootstrap temporal únicamente. En producción debe ser false.
ALLOW_LEGACY_COMMAND_TOKEN=true
COMMAND_CENTER_TOKEN=replace-with-long-random-bootstrap-token

# Amazon Cognito passwordless SMS OTP
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_REPLACE_ME
COGNITO_CLIENT_ID=replace-me

# HMAC para detectar un mismo documento sin guardar el número en claro.
IDENTITY_HASH_SECRET=replace-with-at-least-32-random-bytes

# Evidencias privadas: AWS S3 o API S3-compatible (por ejemplo MinIO on-prem).
PRIVATE_EVIDENCE_BUCKET=sos-eje-cafetero-private-evidence
EVIDENCE_KMS_KEY_ID=
EVIDENCE_RETENTION_DAYS=90
EVIDENCE_MALWARE_SCAN_MODE=DISABLED
REQUIRE_MALWARE_SCAN=false
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Solo para almacenamiento S3-compatible local. En AWS ECS usar task role, no claves estáticas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

JOBS_QUEUE_URL=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace-me
WHATSAPP_APP_SECRET=replace-me
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
