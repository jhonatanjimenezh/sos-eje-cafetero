NODE_ENV=development
POSTGRES_DB=sos
POSTGRES_USER=sos
POSTGRES_PASSWORD=change-me-now
DATABASE_URL=postgresql://sos:change-me-now@db:5432/sos
REDIS_URL=redis://redis:6379
PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Bootstrap temporal únicamente. En producción debe ser false.
ALLOW_LEGACY_COMMAND_TOKEN=true
COMMAND_CENTER_TOKEN=replace-with-long-random-bootstrap-token

# Amazon Cognito passwordless SMS OTP
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_REPLACE_ME
COGNITO_CLIENT_ID=replace-me

# HMAC para detectar un mismo documento sin guardar el número en claro.
IDENTITY_HASH_SECRET=replace-with-at-least-32-random-bytes

# Evidencias privadas: documento, fotos y video de verificación.
PRIVATE_EVIDENCE_BUCKET=sos-eje-cafetero-private-evidence
EVIDENCE_KMS_KEY_ID=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace-me
WHATSAPP_APP_SECRET=replace-me
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
